# Copy to .env and edit. Every value below is optional; scripts fall back to
# the defaults in scripts/lib.sh and configs/production.json.

# Host port published by the container (container port is always 8000).
# PORT=8012

# Bind address for the published port. 127.0.0.1 keeps the API on this host.
# BIND_ADDR=127.0.0.1

# Container and image names.
# CONTAINER=vllm-nanbeige43-33b
# IMAGE=vllm/vllm-openai:latest

# Served model alias.
# SERVED_NAME=pratt-agent2

# Longest sequence the engine will admit. The checkpoint supports 524,288;
# this profile freezes 262,144 to leave KV headroom on one GB10.
# MAX_MODEL_LEN=262144

# Concurrent sequences and prefill chunk.
# MAX_NUM_SEQS=16
# MAX_NUM_BATCHED_TOKENS=8192

# Fraction of unified memory vLLM may plan with.
# GPU_MEMORY_UTILIZATION=0.85

# fp8 halves KV bytes per token; auto lets vLLM use the model dtype.
# KV_CACHE_DTYPE=fp8

# unless-stopped keeps serving across reboots; "no" disables restarts.
# RESTART_POLICY=unless-stopped

# Seconds to wait for /health after start.
# START_TIMEOUT=2400

# Hugging Face token, only needed for gated repositories.
# HF_TOKEN=hf_...
